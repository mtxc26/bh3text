<!DOCTYPE html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content="《崩坏3》<%= title %>章节对话索引，浏览该章节全部对话文本。" />
        <meta name="keywords" content="崩坏3,<%= title %>,对话,章节,剧情" />
        <meta property="og:title" content="<%= title %> - 《崩坏3》文本" />
        <meta property="og:description" content="浏览《崩坏3》<%= title %>的对话文本" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="<%= canonicalUrl %>" />
        <meta name="twitter:card" content="summary" />
        <link rel="canonical" href="<%= canonicalUrl %>" />
        <title><%= title %> - 《崩坏3》文本</title>
        <link rel="icon" type="image/png" href="https://staticassets.bh3text.com/icon.png" />
        <link rel="stylesheet" href="/_r/static/basic.css" />
        <link rel="stylesheet" href="/_r/static/style.css" />
        <link rel="stylesheet" href="/_r/static/chapter-index.css" />
        <script type="text/plain" id="page_title_short"><%= title %></script>
    </head>
    <body>
        <a class="skip-link" href="#main-content">转到内容</a>
        <nav class="back"><a class="nav-up" href="/dialog/">← 对话文本</a></nav>
        <main id="main-content">
            <h1><%= title %></h1><% groups.forEach(function(g) { -%>
            <% if (g.heading) { -%><h2><%= g.heading %></h2><% } -%>
            <ul><% g.items.forEach(function(item) { -%>
                <li><a href="<%= item.url %>"><%= item.label %></a></li><% }) -%>
            </ul><% }) -%>
        </main>
        <%- include('_footer') %>
        <script type="module" src="/_r/runtime/common.js"></script>
    </body>
</html>
