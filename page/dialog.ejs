<!DOCTYPE html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content="《崩坏3》<%= stageTitle %> 对话文本。" />
        <meta name="keywords" content="崩坏3,<%= stageTitle %>,对话,剧情" />
        <meta property="og:title" content="<%= title %> - 《崩坏3》文本" />
        <meta property="og:description" content="《崩坏3》<%= stageTitle %> 对话文本。" />
        <meta property="og:type" content="article" />
        <meta property="og:url" content="<%= canonicalUrl %>" />
        <meta name="twitter:card" content="summary" />
        <link rel="canonical" href="<%= canonicalUrl %>" />
        <title><%= title %> - 《崩坏3》文本</title>
        <link rel="stylesheet" href="/r/static/basic.css" />
        <link rel="stylesheet" href="/r/static/style.css" />
        <link rel="stylesheet" href="/r/static/dialogue.css" />
    </head>
    <body>
        <a class="skip-link" href="#main-content">转到内容</a>
        <nav class="page-nav"><% if (typeof up === 'string') { -%><a class="nav-up" href="<%= up %>">&lt; 返回</a><% } -%><span class="nav-links"><% if (typeof prev === 'object' && prev) { -%><a class="nav-prev" href="<%= prev.url %>" rel="prev">← <%= prev.title %></a><% } -%><% if (typeof next === 'object' && next) { -%><a class="nav-next" href="<%= next.url %>" rel="next"><%= next.title %> →</a><% } -%></span></nav>
        <section id="main-content" aria-labelledby="page-title"><h1 id="page-title"><%= stageTitle %></h1><% if (typeof desc === 'string' && desc) { -%><p class="desc"><%= desc %></p><% } -%></section><% dialogs.forEach(function(dlg) { -%><section class="stage"><% if (dlg.synopsis) { -%><p class="synopsis"><a11y-helper type="hideDisplay" aria-label="梗概：">&gt; </a11y-helper><%= dlg.synopsis %></p><% } -%><% if (dlg.step) { -%><h2 class="step"><%= dlg.step %></h2><% } else if (dlg.type === 'CG') { -%><div class="cg"><a11y-helper type="onlyDisplay" content="【过场动画】">CG: </a11y-helper><%= dlg.cg %></div><% } else { dlg.lines.forEach(function(line) { -%><p class="dialog-line"><% if (line.actor) { -%><span class="dialog-actor"><%- line.actor %></span><% } -%><% if (line.actor && line.content) { -%><a11y-helper type="hideDisplay">：</a11y-helper><% } -%><% if (line.content) { -%><span class="dialog-content"><%- line.content %></span><% } -%></p><% }) } -%></section><% }) -%>
        <%- include('_footer') %>
        
        <script type="module" src="/r/runtime/common.js"></script>
    </body>
</html>
