<!DOCTYPE html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <title><%= hierarchyTitleNoSpace %> - 《崩坏3》文本</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content="《崩坏3》<%= hierarchyTitle %> 所有对话文本查看。" />
        <meta name="keywords" content="崩坏3,<%= hierarchyTitle %>,对话,剧情" />
        <meta property="og:title" content="<%= hierarchyTitle %> - 《崩坏3》文本" />
        <meta property="og:description" content="《崩坏3》<%= hierarchyTitle %> 所有对话文本查看。" />
        <meta property="og:type" content="article" />
        <meta property="og:url" content="<%= canonicalUrl %>" />
        <meta name="twitter:card" content="summary" />
        <link rel="canonical" href="<%= canonicalUrl %>" />
        <link rel="icon" type="image/png" href="https://staticassets.bh3text.com/icon.png" />
        <link rel="stylesheet" href="/_r/static/basic.css" />
        <link rel="stylesheet" href="/_r/static/style.css" />
        <link rel="stylesheet" href="/_r/static/dialogue.css" />
        <script type="text/plain" id="page_title_short"><%= hierarchyTitleB64 %></script>
    </head>
    <body>
        <a class="skip-link" href="#main-content">转到内容</a>
        <script type="text/plain" id="spa-page-content_start"></script><nav class="page-nav"><% if (typeof up === 'string') { -%><a class="nav-up" href="<%= up %>">&lt; 返回</a><% } -%><span class="nav-links"><% if (typeof prev === 'object' && prev) { -%><a class="nav-prev" href="<%= prev.url %>" rel="prev">← <%= prev.title %></a><% } -%><% if (typeof next === 'object' && next) { -%><a class="nav-next" href="<%= next.url %>" rel="next"><%= next.title %> →</a><% } -%></span></nav><section id="main-content" aria-labelledby="page-title"><h1 id="page-title"><%= stageTitle %></h1><% if (typeof desc === 'string' && desc) { -%><p class="desc"><%= desc %></p><% } -%></section><% dialogs.forEach(function(dlg, bi) { -%><section class="stage" id="stage_<%= (bi + 1) %>"><% if (dlg.synopsis) { -%><p class="synopsis"><a11y-helper type="hideDisplay" aria-label="梗概：">&gt; </a11y-helper><%= dlg.synopsis %></p><% } -%><% if (dlg.step) { -%><h2 class="step"><%- dlg.step %></h2><% } else if (dlg.type === 'CG') { -%><div class="cg"><a11y-helper type="onlyDisplay" content="【过场动画】">CG: </a11y-helper><%= dlg.cg %></div><% } else { dlg.lines.forEach(function(line, li) { -%><p class="dialog-line" id="content_<%= (bi + 1) %>_<%= (li + 1) %>"><% if (line.actor) { -%><span class="dialog-actor"><%- line.actor %></span><% } -%><% if (line.actor && line.content) { -%><a11y-helper type="hideDisplay">：</a11y-helper><% } -%><% if (line.content) { -%><span class="dialog-content"><%- line.content %></span><% } -%></p><% }) } -%></section><% }) -%><div id="page-footer-nav-container"></div><script type="text/plain" id="spa-page-content_end"></script>
        <%- include('_footer') %>
        
        <script type="module" src="/_r/runtime/common.js"></script>
    </body>
</html>
