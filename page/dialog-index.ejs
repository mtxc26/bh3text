<!DOCTYPE html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content="《崩坏3》全剧情对话文本目录，包含主线第一部、主线第二部、往世乐土、编年史、活动剧情等全部对话内容，按章节分类浏览。" />
        <meta name="keywords" content="崩坏3,对话,目录,主线,往世乐土,剧情文本" />
        <meta property="og:title" content="《崩坏3》剧情对话文本目录 | 主线·往世乐土·全部章节 | BH3Text" />
        <meta property="og:description" content="《崩坏3》全剧情对话文本目录，包含主线第一部、主线第二部、往世乐土、编年史、活动剧情等全部对话内容。" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://www.bh3text.com/dialog/" />
        <meta name="twitter:card" content="summary" />
        <link rel="canonical" href="https://www.bh3text.com/dialog/" />
        <title>《崩坏3》剧情对话文本目录 | 主线·全部章节 | BH3Text</title>
        <link rel="icon" type="image/png" href="https://staticassets.bh3text.com/icon.png" />
        <link rel="stylesheet" href="/_r/static/basic.css" />
        <link rel="stylesheet" href="/_r/static/style.css" />
        <link rel="stylesheet" href="/_r/static/dialog-index.css" />
    </head>
    <body>
        <a class="skip-link" href="#main-content">转到内容</a>
        <header>
            <nav>
                <a class="nav-up" href="/">&lt; 返回</a>
            </nav>
            <h1>对话文本</h1>
        </header>
        <main id="main-content">
            <% sections.forEach(function(sec) { %>
            <details open>
                <summary><%= sec.label %></summary>
                <% sec.groups.forEach(function(g) { %>
                <details open>
                    <summary><%= g.heading %></summary>
                    <ul>
                        <% g.items.forEach(function(item) { %>
                        <li><a href="<%= item.url %>"><%= item.label %></a></li>
                        <% }) %>
                    </ul>
                </details>
                <% }) %>
            </details>
            <% }) %>
        </main>
        <%- include('_footer') %>
        
        <script type="module" src="/_r/runtime/common.js"></script>
    </body>
</html>
